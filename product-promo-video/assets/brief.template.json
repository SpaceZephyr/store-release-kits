    "url": "https://example.com/",
    "logo": "brand/logo.svg",
    "logoMono": true,
    "colors": { "accent": "#FF5A1F", "accent2": "#1F6BFF" }
  },
  "style": "flat-mg",
  "format": "16:9",
  "captions": true,
  "voice": { "engine": "auto", "speaker": "", "description": "", "seed": 7 },
  "bgm": "auto",
  "bgmVolume": -16,
  "fontFile": "",
  "tokens": {},
  "css": "",
  "scenes": [
    { "type": "logo", "tagline": "一句话 slogan",
      "say": "{ProductName|产品名的中文读法}。一句话 slogan。" },

    { "type": "slogan", "kicker": "ENGLISH NAME", "title": "一句话说清\n这是**什么**", "sub": "补充一句具体的描述",
      "say": "用一两句话说清楚这个产品是做什么的。" },

    { "type": "feature", "kicker": "功能名", "title": "功能标题\n**重点词**", "sub": "具体能做什么",
      "image": "brand/shot-desktop.png", "frame": "browser", "layout": "split",
      "focus": [0.5, 0.4, 1.8], "focusAt": "解决", "callout": "截图里真实存在的一句标注",
      "bullets": ["可选的要点一", "可选的要点二"],
      "say": "这个功能解决什么问题。" },

    { "type": "cards", "title": "**几种**使用场景",
      "items": [
        { "icon": "house", "label": "场景一", "desc": "一句说明" },
        { "icon": "train-front", "label": "场景二", "desc": "一句说明" },
        { "icon": "briefcase", "label": "场景三", "desc": "一句说明" }
      ],
      "say": "在家、在路上、在公司，都能用。" },

    { "type": "feature", "side": "right", "kicker": "移动端", "title": "随时随地\n**都能用**", "sub": "一句说明",
      "image": "brand/shot-mobile.png", "frame": "phone",
      "say": "手机上也一样。" },

    { "type": "stats", "kicker": "数据时间和出处", "title": "**数字**说明一切",
      "items": [ { "value": "100万", "label": "用户" }, { "value": "4.9分", "label": "评分" } ],
      "say": "已经有一百万人在用。" },

    { "type": "tags", "mode": "cloud", "title": "用户**怎么说**",
      "items": ["好用", "省时间", "界面好看", "离不开了"],
      "say": "用过的人都这么说。" },

    { "type": "gallery", "title": "**更多**可能", "images": ["brand/shot-desktop.png", "brand/shot-desktop-2.png", "brand/shot-desktop-3.png"],
      "say": "还有更多功能等你发现。" },

    { "type": "end", "title": "一句话 slogan", "sub": "", "cta": "example.com",
      "say": "产品名，现在就试试。" }
